# =====================================
# DATABASE - SUPABASE POSTGRESQL
# =====================================

# Runtime connection through Supavisor transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection used by Prisma CLI migrations/db push
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# =====================================
# SUPABASE CONFIGURATION
# =====================================

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[SUPABASE_PUBLISHABLE_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE_SECRET_KEY]"

# =====================================
# SUPABASE STORAGE
# =====================================

SUPABASE_STORAGE_BUCKET="girik-assets"

# =====================================
# APPLICATION
# =====================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Account
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@company.com"
ADMIN_PASSWORD="yourPASS"

# Gmail contact notifications (use a Google App Password)
CONTACT_EMAIL="alamat-gmail-perusahaan@gmail.com"
SMTP_USER="alamat-gmail-perusahaan@gmail.com"
SMTP_APP_PASSWORD="app_password_gmail"
