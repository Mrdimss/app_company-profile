generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminLoginThrottle {
  id              String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("admin_login_throttles")
}

enum ContactMessageStatus {
  UNREAD
  READ
}

enum ContactEmailStatus {
  PENDING
  SENT
  FAILED
}

model ContactMessage {
  id                    String               @id @default(cuid())
  name                  String               @db.VarChar(160)
  email                 String               @db.VarChar(254)
  subject               String               @db.VarChar(200)
  message               String               @db.Text
  phone                 String               @db.VarChar(40)
  company               String               @db.VarChar(120)
  country               String               @db.VarChar(100)
  status                ContactMessageStatus @default(UNREAD)
  emailNotification     ContactEmailStatus   @default(PENDING) @map("email_notification")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([emailNotification, createdAt])
  @@map("contact_messages")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  image       String?
  category    String?
  projectUrl  String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@map("projects")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  icon        String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@map("services")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  image       String?
  category    String?
  productUrl  String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@map("products")
}

model CompanySetting {
  id          String   @id @default("company")
  companyName String   @default("GIRIK")
  tagline     String?
  logoUrl     String?
  logoAltText String   @default("Company logo")
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_settings")
}
